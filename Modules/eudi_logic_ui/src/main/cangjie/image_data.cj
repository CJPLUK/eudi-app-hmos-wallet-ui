/* AUTO-GENERATED: bundled iOS assets + SF-symbol equivalents rasterized (Chrome
 * headless) to PNG, embedded as base64 data-URIs. @r/$r resource macro is
 * non-functional in this build; ArkUI Image renders PNG base64 data-URIs. */
package eudi_logic_ui

public func imageDataUri(token: String): String {
    match (token) {
        // eye / eye.slash — accent-blue Details data-visibility toggle
        // (Bootstrap-icons paths rasterized via cairosvg, 96px, #0A59F7).
        case "eye" => "data:image/png;base64,"
        case "eye.slash" => "data:image/png;base64,"
        case "logo" => "data:image/png;base64,"
        case "logo-eu-digital-indentity-wallet" => "data:image/png;base64,"
        case "EUDI-text" => "data:image/png;base64,"
        case "home-identity" => "data:image/png;base64,"
        case "home-contract" => "data:image/png;base64,"
        case "choose-document-image" => "data:image/png;base64,"
        case "scan-document-image" => "data:image/png;base64,"
        case "hourglassImage" => "data:image/png;base64,"
        case "success-secured-wallet" => "data:image/png;base64,"
        case "digital-id-issuance" => "data:image/png;base64,"
        case "document-success-pending" => "data:image/png;base64,"
        case "verified" => "data:image/png;base64,"
        case "relying-party-verified" => "data:image/png;base64,"
        case "wallet-verified" => "data:image/png;base64,"
        case "id" => "data:image/png;base64,"
        case "plus" => "data:image/png;base64,"
        case "line.3.horizontal" => "data:image/png;base64,"
        case "slider.horizontal.3" => "data:image/png;base64,"
        case "magnifyingglass" => "data:image/png;base64,"
        case "gearshape" => "data:image/png;base64,"
        case "chevron.right" => "data:image/png;base64,"
        case "chevron.left" => "data:image/png;base64,"
        case "chevron.up" => "data:image/png;base64,"
        case "chevron.down" => "data:image/png;base64,"
        case "xmark" => "data:image/png;base64,"
        case "checkmark" => "data:image/png;base64,"
        case "house.fill" => "data:image/png;base64,"
        case "house.fill.selected" => "data:image/png;base64,"
        case "doc.fill" => "data:image/png;base64,"
        case "doc.fill.selected" => "data:image/png;base64,"
        case "clock.fill" => "data:image/png;base64,"
        // Pre-tinted variants (raster PNGs ignore fillColor): pending clock in
        // warning yellow / failed-revoked exclamation in red (iOS indicator parity).
        case "clock.fill.warning" => "data:image/png;base64,"
        case "exclamationmark.circle.fill.red" => "data:image/png;base64,"
        case "clock.fill.selected" => "data:image/png;base64,"
        case "info.circle" => "data:image/png;base64,"
        case "123.rectangle" => "data:image/png;base64,"
        case "chevron.down.accent" => "data:image/png;base64,"
        case "chevron.up.accent" => "data:image/png;base64,"
        case "eye.accent" => "data:image/png;base64,"
        case "eye.slash.accent" => "data:image/png;base64,"
        case "doc.text" => "data:image/png;base64,"
        case "faceid" => "data:image/png;base64,"
        case "clock.arrow.trianglehead.2.counterclockwise.rotate.90" => "data:image/png;base64,"
        case "number" => "data:image/png;base64,"
        case "arrow.up.forward.square" => "data:image/png;base64,"
        case "plus.accent" => "data:image/png;base64,"
        case "slider.horizontal.3.disabled" => "data:image/png;base64,"
        case "slider.horizontal.3.accent" => "data:image/png;base64,"
        case "magnifyingglass.gray" => "data:image/png;base64,"
        case "qrcode.viewfinder" => "data:image/png;base64,"
        case "chevron.right.accent" => "data:image/png;base64,"
        case "slider.horizontal.3.black" => "data:image/png;base64,"
        case "checkmark.white" => "data:image/png;base64,"
        case "xmark.bold" => "data:image/png;base64,"
        case _ => ""
    }
}
