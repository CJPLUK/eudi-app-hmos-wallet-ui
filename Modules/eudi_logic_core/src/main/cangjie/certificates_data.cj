 *
 * Trusted reader root certificates (EUDI reference PID Issuer CAs), embedded as
 * hex-encoded DER. iOS bundles the same set as .der resources in
 * Wallet/Certificate/ and loads them via WalletKitConfigImpl.loadCertificate;
 * HarmonyOS has no equivalent code-adjacent bundle path in the cjpm module, so
 * the DER bytes are embedded (public CA certificates, same data as iOS).
 */
package eudi_logic_core

/** name → hex(DER) table for WalletKitConfigImpl.loadCertificate. */
let trustedReaderCertHexTable: Array<(String, String)> = [
    ("pidissuerca02_cz", ""),
    ("pidissuerca02_ee", ""),
    ("pidissuerca02_eu", ""),
    ("pidissuerca02_lu", ""),
    ("pidissuerca02_nl", ""),
    ("pidissuerca02_pt", ""),
    ("pidissuerca02_ut", ""),
]

/** Decode two hex chars per byte; returns None for unknown names. */
func trustedReaderCertDer(name: String): ?Array<UInt8> {
    for ((n, hexStr) in trustedReaderCertHexTable) {
        if (n == name) {
            let bytes = hexStr.toArray()
            let out = Array<UInt8>(bytes.size / 2, repeat: 0u8)
            var i: Int64 = 0
            while (i < out.size) {
                out[i] = (hexNibble(bytes[i * 2]) << 4) | hexNibble(bytes[i * 2 + 1])
                i += 1
            }
            return Some(out)
        }
    }
    return None
}

func hexNibble(c: UInt8): UInt8 {
    if (c >= b'0' && c <= b'9') { return c - b'0' }
    if (c >= b'a' && c <= b'f') { return c - b'a' + 10 }
    if (c >= b'A' && c <= b'F') { return c - b'A' + 10 }
    return 0
}
